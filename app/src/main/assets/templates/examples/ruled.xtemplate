{
 "xtemplate": 1,
 "id": "xtemplate.examples.ruled",
 "name": "Pautado com margem",
 "description": "Linhas horizontais abaixo de um cabeçalho, com linha de margem à esquerda.",
 "license": "MIT",
 "tags": [
  "linhas e grades"
 ],
 "params": {
  "spacing": {
   "type": "length",
   "default": "8mm",
   "min": "5mm",
   "max": "12mm",
   "label": "Espaço entre linhas",
   "role": "spacing"
  },
  "header": {
   "type": "length",
   "default": "24mm",
   "min": "0mm",
   "max": "60mm",
   "label": "Altura do cabeçalho"
  },
  "margin": {
   "type": "length",
   "default": "28mm",
   "min": "0mm",
   "max": "60mm",
   "label": "Largura da margem"
  }
 },
 "items": [
  {
   "type": "group",
   "y": "header",
   "h": "100% - header",
   "children": [
    {
     "type": "repeat",
     "axis": "y",
     "period": "spacing",
     "children": [
      {
       "type": "hline",
       "y": 0
      }
     ]
    }
   ]
  },
  {
   "type": "vline",
   "x": "margin",
   "stroke": "accent"
  }
 ]
}