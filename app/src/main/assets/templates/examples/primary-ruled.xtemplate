{
 "xtemplate": 1,
 "id": "xtemplate.examples.primary-ruled",
 "name": "Caligrafia escolar",
 "description": "Linha de cima, linha do meio tracejada e linha de base colorida, para treinar a letra.",
 "license": "MIT",
 "tags": [
  "escrita"
 ],
 "params": {
  "size": {
   "type": "length",
   "default": "16mm",
   "min": "8mm",
   "max": "30mm",
   "label": "Altura da letra",
   "role": "spacing"
  }
 },
 "items": [
  {
   "type": "group",
   "inset": [
    "15mm",
    "10mm"
   ],
   "children": [
    {
     "type": "repeat",
     "axis": "y",
     "period": "size * 1.6",
     "fit": "space",
     "children": [
      {
       "type": "hline",
       "y": 0
      },
      {
       "type": "hline",
       "y": "size / 2",
       "dash": [
        "2mm",
        "1.5mm"
       ],
       "opacity": 0.6
      },
      {
       "type": "hline",
       "y": "size",
       "stroke": "accent",
       "strokeWidth": "0.4mm"
      }
     ]
    }
   ]
  }
 ]
}