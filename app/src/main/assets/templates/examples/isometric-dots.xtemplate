{
 "xtemplate": 1,
 "id": "xtemplate.examples.isometric-dots",
 "name": "Pontos isométricos",
 "description": "Pontos em grade isométrica para desenhos em 3D.",
 "license": "MIT",
 "tags": [
  "desenho"
 ],
 "params": {
  "side": {
   "type": "length",
   "default": "6mm",
   "min": "3mm",
   "max": "20mm",
   "label": "Espaço entre pontos",
   "role": "spacing"
  }
 },
 "items": [
  {
   "type": "repeat",
   "axis": "xy",
   "period": [
    "side",
    "side * sin(60)"
   ],
   "stagger": "side / 2",
   "extend": true,
   "children": [
    {
     "type": "dot",
     "r": "0.35mm"
    }
   ]
  }
 ]
}