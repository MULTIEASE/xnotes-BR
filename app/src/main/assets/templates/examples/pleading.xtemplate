{
 "xtemplate": 1,
 "id": "xtemplate.examples.pleading",
 "name": "Folha numerada (peças)",
 "description": "Linhas numeradas com margem pautada à esquerda, como em petições.",
 "license": "MIT",
 "tags": [
  "escrita",
  "negócios"
 ],
 "params": {
  "lines": {
   "type": "integer",
   "default": 28,
   "min": 20,
   "max": 40,
   "label": "Linhas numeradas"
  }
 },
 "items": [
  {
   "type": "vline",
   "x": "38mm"
  },
  {
   "type": "vline",
   "x": "39mm"
  },
  {
   "type": "vline",
   "x": "100% - 12mm"
  },
  {
   "type": "group",
   "y": "25mm",
   "h": "100% - 50mm",
   "children": [
    {
     "type": "repeat",
     "axis": "y",
     "count": "lines",
     "children": [
      {
       "type": "text",
       "text": "{i + 1}",
       "x": "34mm",
       "y": "100% - 1.5mm",
       "align": "end",
       "font": "serif",
       "size": "3.5mm"
      }
     ]
    }
   ]
  }
 ]
}