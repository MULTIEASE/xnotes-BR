{
 "xtemplate": 1,
 "id": "xtemplate.examples.dot-grid",
 "name": "Pontilhado (bullet journal)",
 "description": "Pontos discretos em grade, o clássico do bullet journal.",
 "license": "MIT",
 "tags": [
  "linhas e grades",
  "diário"
 ],
 "params": {
  "size": {
   "type": "length",
   "default": "5mm",
   "min": "3mm",
   "max": "15mm",
   "label": "Espaço entre pontos",
   "role": "spacing"
  }
 },
 "items": [
  {
   "type": "group",
   "inset": "6mm",
   "children": [
    {
     "type": "repeat",
     "axis": "xy",
     "period": "size",
     "fit": "center",
     "children": [
      {
       "type": "dot",
       "cx": "50%",
       "cy": "50%",
       "r": "0.3mm"
      }
     ]
    }
   ]
  }
 ]
}