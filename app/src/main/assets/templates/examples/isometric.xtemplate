{
 "xtemplate": 1,
 "id": "xtemplate.examples.isometric",
 "name": "Grade isométrica",
 "description": "Triângulos para desenhos em perspectiva isométrica.",
 "license": "MIT",
 "tags": [
  "desenho"
 ],
 "params": {
  "side": {
   "type": "length",
   "default": "8mm",
   "min": "4mm",
   "max": "25mm",
   "label": "Lado do triângulo",
   "role": "spacing"
  }
 },
 "strokeWidth": "0.18mm",
 "items": [
  {
   "type": "hatch",
   "angle": 90,
   "period": "side * sin(60)",
   "extend": true
  },
  {
   "type": "hatch",
   "angle": 30,
   "period": "side * sin(60)",
   "extend": true
  },
  {
   "type": "hatch",
   "angle": 150,
   "period": "side * sin(60)",
   "extend": true
  }
 ]
}