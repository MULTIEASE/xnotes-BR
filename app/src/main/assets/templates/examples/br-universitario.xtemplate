{
 "xtemplate": 1,
 "id": "br.xnotes.universitario",
 "name": "Pautado universitário",
 "description": "Linhas a cada 7 mm, margem vermelha à esquerda e cabeçalho com data, como o caderno universitário.",
 "license": "MIT",
 "author": "xnotes BR",
 "tags": [
  "linhas e grades"
 ],
 "params": {
  "spacing": {
   "type": "length",
   "default": "7mm",
   "min": "4mm",
   "max": "12mm",
   "label": "Espaço entre linhas",
   "role": "spacing"
  }
 },
 "items": [
  {
   "type": "text",
   "text": "Data ____/____/______",
   "x": "100% - 12mm",
   "y": "13mm",
   "size": "3mm",
   "fill": "ink",
   "align": "end",
   "opacity": 0.7
  },
  {
   "type": "hline",
   "y": "20mm",
   "x1": 0,
   "x2": "100%",
   "stroke": "accent",
   "strokeWidth": "0.35mm"
  },
  {
   "type": "group",
   "x": 0,
   "y": "20mm",
   "w": "100%",
   "h": "100% - 28mm",
   "children": [
    {
     "type": "repeat",
     "axis": "y",
     "period": "spacing",
     "children": [
      {
       "type": "hline",
       "y": "100%"
      }
     ]
    }
   ]
  },
  {
   "type": "vline",
   "x": "25mm",
   "y1": 0,
   "y2": "100%",
   "stroke": "accent",
   "strokeWidth": "0.35mm"
  }
 ]
}