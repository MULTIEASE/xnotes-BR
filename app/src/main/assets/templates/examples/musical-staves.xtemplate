{
 "xtemplate": 1,
 "id": "xtemplate.examples.musical-staves",
 "name": "Pauta musical",
 "description": "Pautas de cinco linhas para partitura.",
 "license": "MIT",
 "tags": [
  "música"
 ],
 "params": {
  "gap": {
   "type": "length",
   "default": "2mm",
   "min": "1.2mm",
   "max": "3mm",
   "label": "Espaço entre linhas",
   "role": "spacing"
  }
 },
 "items": [
  {
   "type": "group",
   "inset": [
    "15mm",
    "12mm"
   ],
   "children": [
    {
     "type": "repeat",
     "axis": "y",
     "period": "gap * 10",
     "fit": "space",
     "children": [
      {
       "type": "repeat",
       "axis": "none",
       "count": 5,
       "children": [
        {
         "type": "hline",
         "y": "gap * (3 + i)"
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}