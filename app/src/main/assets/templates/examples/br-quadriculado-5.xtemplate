   "label": "Tamanho do quadrado",
   "role": "spacing"
  }
 },
 "items": [
  {
   "type": "group",
   "x": "10mm",
   "y": "20mm",
   "w": "100% - 20mm",
   "h": "100% - 28mm",
   "children": [
    {
     "type": "repeat",
     "axis": "x",
     "period": "spacing",
     "children": [
      {
       "type": "vline",
       "x": 0,
       "opacity": 0.55
      }
     ]
    },
    {
     "type": "repeat",
     "axis": "y",
     "period": "spacing",
     "children": [
      {
       "type": "hline",
       "y": 0,
       "opacity": 0.55
      }
     ]
    },
    {
     "type": "rect",
     "stroke": "accent",
