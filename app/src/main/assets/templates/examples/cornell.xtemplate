{
 "xtemplate": 1,
 "id": "xtemplate.examples.cornell",
 "name": "Cornell (anotações de aula)",
 "description": "Coluna de perguntas, área de anotações e resumo no rodapé.",
 "license": "MIT",
 "tags": [
  "estudos"
 ],
 "params": {
  "spacing": {
   "type": "length",
   "default": "8mm",
   "min": "5mm",
   "max": "12mm",
   "label": "Espaço entre linhas",
   "role": "spacing"
  },
  "cue": {
   "type": "number",
   "default": 0.3,
   "min": 0.15,
   "max": 0.45,
   "step": 0.05,
   "label": "Largura da coluna de perguntas"
  },
  "summary": {
   "type": "length",
   "default": "50mm",
   "min": "25mm",
   "max": "90mm",
   "label": "Altura do resumo"
  }
 },
 "items": [
  {
   "type": "group",
   "stroke": "accent",
   "strokeWidth": "0.35mm",
   "children": [
    {
     "type": "hline",
     "y": "22mm"
    },
    {
     "type": "hline",
     "y": "100% - summary"
    },
    {
     "type": "vline",
     "x": "W * cue",
     "y1": "22mm",
     "y2": "100% - summary"
    }
   ]
  },
  {
   "type": "group",
   "x": "W * cue",
   "y": "22mm",
   "w": "100% - W * cue",
   "h": "100% - 22mm - summary",
   "children": [
    {
     "type": "repeat",
     "axis": "y",
     "period": "spacing",
     "children": [
      {
       "type": "hline",
       "y": "100%"
      }
     ]
    }
   ]
  },
  {
   "type": "group",
   "y": "100% - summary",
   "h": "summary",
   "children": [
    {
     "type": "repeat",
     "axis": "y",
     "period": "spacing",
     "children": [
      {
       "type": "hline",
       "y": "100%"
      }
     ]
    }
   ]
  },
  {
   "type": "group",
   "fill": "accent",
   "size": "3mm",
   "children": [
    {
     "type": "text",
     "text": "Cues",
     "x": "4mm",
     "y": "28mm"
    },
    {
     "type": "text",
     "text": "Notes",
     "x": "W * cue + 4mm",
     "y": "28mm"
    },
    {
     "type": "text",
     "text": "Summary",
     "x": "4mm",
     "y": "100% - summary + 6mm"
    }
   ]
  }
 ]
}